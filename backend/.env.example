# Copy to .env and adjust. Every value has a safe development default.

APP_NAME="NGO Volunteer and Donation Management System"
NGO_NAME="Helping Hands NGO"
ENV=development                 # set to "production" to enforce a real SECRET_KEY
APP_TIMEZONE=Asia/Kolkata       # "today" for campaign end dates; naive event datetimes are read in this zone

# --- Database (SQLite for the lab, PostgreSQL for production; OE-3) ---
DATABASE_URL=sqlite:///./vdms.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vdms   (pip install "psycopg[binary]")

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string        # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: origins of the frontend dev server / deployment, comma separated ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Donations ---
MAX_SINGLE_DONATION=1000000.00  # TBD-1: configurable single-donation limit
PAYMENT_FAILURE_RATE=0          # 0..1: chance the simulated gateway declines a payment
PAYMENT_ALLOW_FORCED_OUTCOME=true  # lets the frontend pass simulate_outcome=success|failure (demo/testing)

# --- E-mail (leave SMTP_HOST empty to just log e-mails; see GET /api/v1/admin/email-log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@ngo.local

# --- First admin account, created on startup if no admin exists ---
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=NGO Admin

# --- Background job (auto-close campaigns / auto-complete events) ---
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_INTERVAL_SECONDS=60
